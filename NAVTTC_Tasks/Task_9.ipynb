        "import cmath\n",
        "\n",
        "a=1\n",
        "b=5\n",
        "c=6\n",
        "\n",
        "d=(b**2) - (4*a*c)\n",
        "sol1 = (-b-cmath.sqrt(d))/(2*a)\n",
        "sol2 = (-b+cmath.sqrt(d))/(2*a)\n",
        "\n",
        "print('solution of {0} and {1} is' .format(sol1, sol2))"
